<Window x:Class="WpfApp1.CaptionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse 实时字幕" Width="850" Height="230" MinWidth="320" MinHeight="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="SubtitleSurface" CornerRadius="14" Padding="18,10,18,18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <Grid x:Name="Controls" Margin="0,0,0,8">
                <TextBlock Text="Glimpse · 拖动移动 · Ctrl+Alt+L 锁定/解锁" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,120,0" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="DragHeader" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="锁定" Click="Lock_Click" Padding="8,3" Margin="5,0" ToolTip="锁定后鼠标穿透，可从托盘或 Ctrl+Alt+L 解锁" />
                    <Button Content="隐藏" Click="Hide_Click" Padding="8,3" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="等待中文字幕…" TextWrapping="Wrap"
                       Foreground="White" FontWeight="SemiBold" FontSize="28" TextAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="1" /></TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>
