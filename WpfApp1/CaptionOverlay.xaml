<Window x:Class="WpfApp1.CaptionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimpse 实时字幕" Width="850" Height="230" MinWidth="320" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="DragStarted" Handler="Resize_Started" />
            <EventSetter Event="DragDelta" Handler="Resize_Delta" />
            <EventSetter Event="DragCompleted" Handler="Resize_Completed" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#304B5970" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="SubtitleSurface" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <Border x:Name="Controls" Background="#D0202633" CornerRadius="14,14,0,0" Padding="12,6" MinHeight="40"
                        PreviewMouseLeftButtonDown="DragHeader" Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Glimpse · 拖动此栏移动字幕" Foreground="#E5E9F2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Cursor="Arrow">
                            <Button Content="外观" Style="{StaticResource HeaderButton}" Click="Appearance_Click" />
                            <Button Content="居中" Style="{StaticResource HeaderButton}" Click="Center_Click" ToolTip="回到当前屏幕下方居中" />
                            <Button Content="锁定" Style="{StaticResource HeaderButton}" Click="Lock_Click" ToolTip="锁定后鼠标穿透；Ctrl+Alt+L 或托盘解锁" />
                            <Button Content="隐藏" Style="{StaticResource HeaderButton}" Click="Hide_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="18,12,18,16" Text="等待中文字幕…" TextWrapping="Wrap"
                           Foreground="White" FontWeight="SemiBold" FontSize="28" TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="1" /></TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>
        <Grid x:Name="ResizeHandles">
            <Thumb Tag="Left" Style="{StaticResource ResizeThumb}" Width="7" HorizontalAlignment="Left" Cursor="SizeWE" />
            <Thumb Tag="Right" Style="{StaticResource ResizeThumb}" Width="7" HorizontalAlignment="Right" Cursor="SizeWE" />
            <Thumb Tag="Top" Style="{StaticResource ResizeThumb}" Height="6" VerticalAlignment="Top" Cursor="SizeNS" />
            <Thumb Tag="Bottom" Style="{StaticResource ResizeThumb}" Height="7" VerticalAlignment="Bottom" Cursor="SizeNS" />
            <Thumb Tag="LeftTop" Style="{StaticResource ResizeThumb}" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
            <Thumb Tag="RightTop" Style="{StaticResource ResizeThumb}" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
            <Thumb Tag="LeftBottom" Style="{StaticResource ResizeThumb}" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
            <Thumb Tag="RightBottom" Style="{StaticResource ResizeThumb}" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" ToolTip="拖动调整字幕窗大小" />
            <Path Data="M0,8 L8,0 M5,8 L8,5" Stroke="#9CA8BE" StrokeThickness="1.5" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" IsHitTestVisible="False" />
        </Grid>
        <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=Controls}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Width="300">
                <StackPanel>
                    <TextBlock Text="字幕外观" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                    <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding ElementName=OverlayFontSize, Path=Value, StringFormat='字号：{0:0}'}" />
                    <Slider x:Name="OverlayFontSize" Minimum="16" Maximum="72" Value="28" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Style_Changed" Margin="0,5,0,12" />
                    <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding ElementName=OverlayBackgroundOpacity, Path=Value, StringFormat='背景不透明度：{0:P0}'}" />
                    <Slider x:Name="OverlayBackgroundOpacity" Minimum="0" Maximum="1" Value="0.35" ValueChanged="Style_Changed" Margin="0,5,0,12" />
                    <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding ElementName=OverlayTextOpacity, Path=Value, StringFormat='文字不透明度：{0:P0}'}" />
                    <Slider x:Name="OverlayTextOpacity" Minimum="0.25" Maximum="1" Value="1" ValueChanged="Style_Changed" Margin="0,5,0,12" />
                    <WrapPanel>
                        <Button Click="TextColor_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Rectangle x:Name="TextColorSwatch" Width="13" Height="13" Fill="White" Stroke="#8490A5" Margin="0,0,7,0" /><TextBlock Text="文字颜色" /></StackPanel></Button>
                        <Button Click="BackgroundColor_Click"><StackPanel Orientation="Horizontal"><Rectangle x:Name="BackgroundColorSwatch" Width="13" Height="13" Fill="Black" Stroke="#8490A5" Margin="0,0,7,0" /><TextBlock Text="底板颜色" /></StackPanel></Button>
                    </WrapPanel>
                    <TextBlock Text="即时生效并保存 · Ctrl+Alt+L 锁定/解锁" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
