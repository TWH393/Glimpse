<UserControl x:Class="WpfApp1.MediaTranslationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel Margin="0,20,0,0">
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="音视频转译" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="导入本地文件，提取英文并翻译为中文，生成带时间戳的中英对照文本。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <StackPanel x:Name="ConfigurationPanel">
                        <TextBlock Text="音频或视频文件" Style="{StaticResource Hint}" />
                        <DockPanel Margin="0,6,0,12">
                            <Button DockPanel.Dock="Right" Content="选择文件" Click="BrowseFile_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="InputPath" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="文本保存目录" Style="{StaticResource Hint}" />
                        <DockPanel Margin="0,6,0,12">
                            <Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseFolder_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="OutputFolder" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <WrapPanel>
                            <TextBlock Text="处理设备" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="DeviceBox" Width="220" SelectedIndex="0">
                                <ComboBoxItem Content="仅 GPU · 识别与翻译" />
                                <ComboBoxItem Content="仅 CPU · 识别与翻译" />
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="复用实时字幕设置中的语音环境及模型路径，以及偏好设置中的 Hy-MT2。默认音轨优先，否则取第一条音轨；与实时字幕互斥。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="JobStatus" Text="选择文件后开始。支持 MP3、WAV、M4A、FLAC、MP4、MKV 等本地文件。" TextWrapping="Wrap" />
                    <ProgressBar x:Name="JobProgress" Minimum="0" Maximum="100" Height="7" Margin="0,14,0,8" />
                    <TextBlock x:Name="ProgressText" Text="等待处理…" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TimingText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="中英对照预览" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="StreamingText" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,10,0,8" MaxHeight="100" />
                    <TextBox x:Name="TranscriptPreview" Height="280" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="15" BorderThickness="0" />
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="StartButton" Content="开始转译" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,8" />
                <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" Margin="0,0,8,8" />
                <Button x:Name="CancelButton" Content="取消并保存" Click="Cancel_Click" IsEnabled="False" Margin="0,0,8,8" />
                <Button Content="打开文本" Click="OpenText_Click" Margin="0,0,8,8" />
                <Button Content="另存为" Click="SaveAs_Click" Margin="0,0,8,8" />
                <Button Content="打开目录" Click="OpenFolder_Click" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock x:Name="OutputText" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,4,0,12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
