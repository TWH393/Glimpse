<UserControl x:Class="WpfApp1.LiveCaptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="应用实时字幕 · 本地英语 → 中文字幕" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Windows 11 · 按音量合成器的音频会话筛选应用；可选择单应用或全局输出，不直接录制麦克风，默认不保存录音。" Style="{StaticResource Hint}" Margin="0,7,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ApplicationsBox" DropDownOpened="Applications_Opened" ToolTip="只列出有输出音频会话的应用，包含暂时空闲的会话；全局识别包含其他应用和系统声音">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="RefreshApplicationsButton" Grid.Column="1" Content="刷新应用" Click="Refresh_Click" Margin="8,0" />
                    <ProgressBar x:Name="AudioLevel" Grid.Column="2" Width="80" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center" ToolTip="所选应用音量" />
                </Grid>
                <Expander Header="语音模型与字幕设置" Margin="0,12,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="语音识别 Python（独立环境）" Style="{StaticResource Hint}" />
                        <DockPanel Margin="0,5,0,9"><Button DockPanel.Dock="Right" Content="浏览" Click="BrowsePython_Click" Margin="8,0,0,0" /><TextBox x:Name="SpeechPythonBox" /></DockPanel>
                        <TextBlock Text="英语模型目录（包含 model.bin）" Style="{StaticResource Hint}" />
                        <DockPanel Margin="0,5,0,9"><Button DockPanel.Dock="Right" Content="浏览" Click="BrowseModel_Click" Margin="8,0,0,0" /><TextBox x:Name="SpeechModelBox" /></DockPanel>
                        <WrapPanel>
                            <CheckBox x:Name="GpuOnlyCheck" Content="同传仅 GPU" IsChecked="True" VerticalAlignment="Center" Click="GpuOnly_Click" Margin="0,0,16,0" ToolTip="识别和翻译都禁止回退 CPU，失败后保存并重启一次，再失败则停止" />
                            <TextBlock Text="识别设备" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SpeechDeviceBox" Width="150" SelectedIndex="1" Margin="0,0,16,0"><ComboBoxItem Content="自动" /><ComboBoxItem Content="优先 GPU" /><ComboBoxItem Content="仅 CPU" /></ComboBox>
                            <CheckBox x:Name="BilingualCheck" Content="显示中英双语" VerticalAlignment="Center" Click="Options_Click" />
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="字幕字号" VerticalAlignment="Center" Margin="0,0,8,0" /><Slider x:Name="CaptionSize" Width="110" Minimum="16" Maximum="72" Value="28" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Options_Changed" VerticalAlignment="Center" />
                            <TextBlock Text="背景不透明度" VerticalAlignment="Center" Margin="20,0,8,0" /><Slider x:Name="CaptionOpacity" Width="110" Minimum="0" Maximum="1" Value="0.35" ValueChanged="Options_Changed" VerticalAlignment="Center" ToolTip="0 为完全透明，向右增加底板浓度" />
                            <TextBlock Text="文字不透明度" VerticalAlignment="Center" Margin="20,0,8,0" /><Slider x:Name="CaptionTextOpacity" Width="110" Minimum="0.25" Maximum="1" Value="1" ValueChanged="Options_Changed" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Click="CaptionTextColor_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Rectangle x:Name="CaptionTextColorSwatch" Width="13" Height="13" Fill="White" Stroke="#8490A5" Margin="0,0,7,0" /><TextBlock Text="文字颜色" /></StackPanel></Button>
                            <Button Click="CaptionBackgroundColor_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Rectangle x:Name="CaptionBackgroundColorSwatch" Width="13" Height="13" Fill="Black" Stroke="#8490A5" Margin="0,0,7,0" /><TextBlock Text="底板颜色" /></StackPanel></Button>
                            <Button Content="保存字幕设置" Click="SaveOptions_Click" />
                        </WrapPanel>
                        <TextBlock Text="外观即时生效并保存，也可在字幕窗顶部点“外观”调整。拖动顶部栏移动，拖动四边或四角缩放；每次打开在当前屏幕下方居中，保留上次尺寸。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock Text="仅 GPU 同时约束识别和翻译，失败不回退 CPU；取消勾选后才使用原设备选择。会话最多自动重启一次，第二次失败停止并保存。变更下次会话生效。" Style="{StaticResource Hint}" Margin="0,9,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="英文草稿 · 确认后才翻译和记录" Style="{StaticResource Hint}" />
                <TextBlock x:Name="DraftText" Grid.Row="1" Text="等待开始…" TextWrapping="Wrap" MaxHeight="65" Margin="0,6,0,12" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="StreamingText" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" MaxHeight="75" Margin="0,0,0,8" FontSize="16" />
                <TextBlock x:Name="TimingText" Grid.Row="3" Text="耗时：等待第一条字幕。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBox x:Name="SessionPreview" Grid.Row="4" Height="240" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontSize="15" BorderThickness="0" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="StartButton" Content="开始字幕" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,0" />
                <Button x:Name="PauseButton" Content="暂停" IsEnabled="False" Click="Pause_Click" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="停止并保存" IsEnabled="False" Click="Stop_Click" Margin="0,0,8,0" />
                <Button Content="显示/隐藏字幕" Click="Overlay_Click" Margin="0,0,8,0" />
                <Button Content="锁定/解锁" Click="Lock_Click" Margin="0,0,8,0" />
                <Button Content="打开记录" Click="OpenTranscript_Click" Margin="0,0,8,0" />
                <Button Content="另存为" Click="SaveTranscript_Click" Margin="0,0,8,0" />
                <Button Content="记录文件夹" Click="Folder_Click" />
            </WrapPanel>
            <TextBlock x:Name="SessionStatus" Text="准备就绪 · 首次使用需运行 tools/install_speech.ps1 准备语音环境。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
